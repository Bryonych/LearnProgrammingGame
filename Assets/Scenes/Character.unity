  m_text: "public class Character { \n\n\tstring name = \t\t\t\t\t// Remember to
    put a ; after each variable\n\tint age = \n\tboolean wearsShoes = \n\tboolean
    wearsHat = \n\tboolean hasHair =\n\tboolean wearsGlasses =\n\tboolean darkSkin
    =\n\t\n\tShoes shoes = null;\t\t// These variables are intiated to null. If you
    set the booleans to  \t\n\tHat hat = null;\t\t\t// true above, select the options
    in the constructor below \t\t\t\t\n\tHair hair = null;\t\t\t\t\n\tGlasses glasses
    = null;\t\n\n\tpublic Character() {\n\t\tif (wearsShoes) {\t\t// This is the
    same as saying if wearsShoes == true\n\t\t\tthis.shoes = new Shoes(                                       
    );\t// Options are \"shoes\" or \"boots\"\n\t\t}\n\t\tif (wearsHat) {\n\t\t\tthis.hat
    = new Hat(                                        );\t// Options are \"cap\"
    or \"top hat\"\n\t\t}\n\t\tif (hasHair) {\n\t\t\tthis.hair = new Hair(                                       
    );\t\t// Options are \"long green\", \"dreads\",   \n\t\t}\t\t\t\t\t\t\t\t\t\t\t//
    \"short orange\" or \"short black\"\n\t\tif (wearsGlasses) {\n\t\t\tthis.glasses
    = new Glasses(                                        );\t// Options are \"glasses\"
    or\n\t\t}\t\t\t\t\t\t\t\t\t\t\t// \"sun glasses\"\n\t}\t\n\n}"
  m_isRightToLeft: 0
